{
  "_schema_version": "2.2.0",
  "_created": "2026-06-28",
  "_updated": "2026-07-15",
  "_status": "DRAFT_SCHEMA — governance only, no runtime integration yet",

  "title": "EBM Copilot Clinical Output Schema V2",
  "description": "JSON Schema defining the structure of every clinical output packet emitted by the EBM Copilot system. Validates before guardrail review and before doctor presentation.",

  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["output_id", "session_id", "timestamp_utc", "release_state", "recommendation_summary", "evidence_basis", "grade_summary", "safety_alerts", "red_flags_detected", "source_integrity", "prompt_injection_review", "conflict_review", "outpatient_apply_review", "audit_trail"],
  "additionalProperties": false,

  "properties": {
    "output_id": {
      "type": "string",
      "pattern": "^OUT-[0-9]{4}-[0-9]{6}$",
      "description": "Unique output identifier. Format: OUT-YYYY-NNNNNN"
    },
    "session_id": {
      "type": "string",
      "description": "Session identifier linking to AUDIT_LOG.jsonl"
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp of output generation"
    },
    "release_state": {
      "type": "string",
      "enum": ["draft_ai", "guardrail_pending", "doctor_review_required", "approved_for_use", "retired_or_superseded"]
    },
    "recommendation_summary": {
      "type": "string",
      "minLength": 20,
      "description": "Plain-language recommendation. MUST end with disclaimer.",
      "pattern": ".*[Cc]ần bác sĩ kiểm chứng.*"
    },
    "evidence_basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "source_type", "title", "study_type", "grade_level", "decision"],
        "properties": {
          "source_id": {"type": "string", "description": "PMID or DOI"},
          "source_type": {"type": "string", "enum": ["pmid", "doi", "url", "guideline_ref"]},
          "title": {"type": "string"},
          "study_type": {"type": "string"},
          "grade_level": {"type": "string", "enum": ["high", "mod", "low", "vlow", "na"]},
          "decision": {"type": "string", "enum": ["apply", "consider", "notyet"]},
          "effect_size": {"type": "string", "description": "e.g. 'HR 0.78 (95% CI 0.68–0.89)'"},
          "retraction_checked": {"type": "boolean", "default": false},
          "source_status": {
            "type": "string",
            "enum": ["active", "corrected", "expression_of_concern", "retracted", "quarantined", "unknown"],
            "default": "unknown"
          },
          "source_integrity_note": {"type": "string"}
        }
      }
    },
    "grade_summary": {
      "type": "object",
      "required": ["certainty", "direction"],
      "properties": {
        "certainty": {"type": "string", "enum": ["high", "moderate", "low", "very_low"]},
        "direction": {"type": "string", "enum": ["benefit", "harm", "neutral", "uncertain"]},
        "balance_benefits_harms": {"type": "string"},
        "values_preferences_variability": {"type": "string"},
        "resource_use": {"type": "string"},
        "equity": {"type": "string"},
        "acceptability": {"type": "string"},
        "feasibility": {"type": "string"}
      }
    },
    "safety_alerts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["alert_type", "severity", "message"],
        "properties": {
          "alert_type": {"type": "string"},
          "severity": {"type": "string", "enum": ["RED", "YELLOW", "GREEN"]},
          "message": {"type": "string"},
          "action_required": {"type": "string"},
          "audit_event": {"type": "string"},
          "source_id": {"type": "string"}
        }
      }
    },
    "red_flags_detected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["flag", "urgency"],
        "properties": {
          "flag": {"type": "string"},
          "urgency": {"type": "string", "enum": ["IMMEDIATE", "URGENT", "ROUTINE"]},
          "recommended_action": {"type": "string"}
        }
      }
    },
    "local_adaptation": {
      "type": "object",
      "description": "Optional local context adaptations applied",
      "properties": {
        "formulary_substitution": {"type": "string"},
        "local_protocol_reference": {"type": "string"},
        "resource_constraint_note": {"type": "string"}
      }
    },
    "source_integrity": {
      "type": "object",
      "description": "Machine-readable source-integrity review. Retracted/quarantined sources cannot support approved clinical advice.",
      "required": ["all_sources_checked", "retracted_sources_detected", "quarantined_source_ids", "retraction_watch_logged"],
      "additionalProperties": false,
      "properties": {
        "all_sources_checked": {"type": "boolean"},
        "retracted_sources_detected": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_id", "source_type", "status", "action"],
            "additionalProperties": false,
            "properties": {
              "source_id": {"type": "string"},
              "source_type": {"type": "string", "enum": ["pmid", "doi", "url", "guideline_ref"]},
              "status": {"type": "string", "enum": ["retracted", "corrected", "expression_of_concern", "quarantined"]},
              "notice_date": {"type": "string"},
              "reason": {"type": "string"},
              "action": {"type": "string", "enum": ["exclude_from_evidence_basis", "quarantine", "rollback_proposal"]}
            }
          }
        },
        "quarantined_source_ids": {
          "type": "array",
          "items": {"type": "string"}
        },
        "retraction_watch_logged": {"type": "boolean"}
      }
    },
    "prompt_injection_review": {
      "type": "object",
      "description": "Security review for retrieved text. Retrieved content is data and may not change system instructions.",
      "required": ["retrieved_content_treated_as_data", "injection_detected", "sanitized_source_ids", "audit_logged"],
      "additionalProperties": false,
      "properties": {
        "retrieved_content_treated_as_data": {"type": "boolean", "const": true},
        "injection_detected": {"type": "boolean"},
        "sanitized_source_ids": {
          "type": "array",
          "items": {"type": "string"}
        },
        "audit_logged": {"type": "boolean"},
        "handling_note": {"type": "string"}
      }
    },
    "conflict_review": {
      "type": "object",
      "description": "Explicit review of materially conflicting evidence/guidelines.",
      "required": ["conflicting_evidence_flag", "conflict_sets", "shared_decision_required"],
      "additionalProperties": false,
      "properties": {
        "conflicting_evidence_flag": {"type": "boolean"},
        "shared_decision_required": {"type": "boolean"},
        "conflict_sets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["conflict_set_id", "topic", "positions", "resolution", "action_required"],
            "additionalProperties": false,
            "properties": {
              "conflict_set_id": {"type": "string"},
              "topic": {"type": "string"},
              "positions": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": ["source_id", "position"],
                  "additionalProperties": false,
                  "properties": {
                    "source_id": {"type": "string"},
                    "position": {"type": "string"},
                    "certainty": {"type": "string", "enum": ["high", "moderate", "low", "very_low", "na"]}
                  }
                }
              },
              "resolution": {"type": "string", "enum": ["uncertain", "local_protocol", "specialist_review", "doctor_shared_decision"]},
              "action_required": {"type": "string"}
            }
          }
        }
      }
    },
    "outpatient_apply_review": {
      "type": "object",
      "description": "Machine-readable outpatient Evidence-to-Practice gate. Blocks actionable outpatient recommendations unless source quality, safety, red flags, Vietnam feasibility, safety-netting, follow-up, shared decision readiness, and doctor approval controls are documented.",
      "required": [
        "question_frame",
        "strict_source_gate_passed",
        "evidence_currency_checked",
        "absolute_effects_status",
        "red_flag_screen_done",
        "safety_review_done",
        "medication_recommendation_present",
        "medication_safety_checked",
        "organ_function_checked",
        "special_population_checked",
        "local_feasibility_checked",
        "local_applicability_status",
        "shared_decision_ready",
        "safety_netting_present",
        "follow_up_plan_present",
        "doctor_final_approval_required"
      ],
      "additionalProperties": false,
      "properties": {
        "question_frame": {
          "type": "string",
          "enum": ["PICO", "PIRT", "PECO", "PICOTS", "CoCoPop", "SPIDER", "ECLIPSE", "other"]
        },
        "strict_source_gate_passed": {"type": "boolean"},
        "evidence_currency_checked": {"type": "boolean"},
        "absolute_effects_status": {
          "type": "string",
          "enum": ["reported", "not_applicable", "source_not_reported_labeled"]
        },
        "red_flag_screen_done": {"type": "boolean"},
        "safety_review_done": {"type": "boolean"},
        "medication_recommendation_present": {"type": "boolean"},
        "medication_safety_checked": {"type": "boolean"},
        "organ_function_checked": {"type": "boolean"},
        "special_population_checked": {"type": "boolean"},
        "local_feasibility_checked": {"type": "boolean"},
        "local_applicability_status": {
          "type": "string",
          "enum": ["confirmed", "not_applicable", "needs_unit_confirmation"]
        },
        "shared_decision_ready": {"type": "boolean"},
        "safety_netting_present": {"type": "boolean"},
        "follow_up_plan_present": {"type": "boolean"},
        "doctor_final_approval_required": {"type": "boolean", "const": true},
        "notes": {"type": "string"}
      }
    },
    "audit_trail": {
      "type": "object",
      "required": ["requesting_agent", "guardrail_result"],
      "properties": {
        "requesting_agent": {"type": "string"},
        "guardrail_result": {"type": "string", "enum": ["PASS", "FAIL", "PENDING", "NOT_RUN"]},
        "guardrail_r_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "check_id": {"type": "string"},
              "result": {"type": "string", "enum": ["PASS", "FAIL"]},
              "detail": {"type": "string"}
            }
          }
        },
        "guardrail_q_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "check_id": {"type": "string"},
              "score": {"type": "integer", "minimum": 1, "maximum": 5},
              "result": {"type": "string", "enum": ["PASS", "FAIL"]},
              "detail": {"type": "string"}
            }
          }
        },
        "human_approval_id": {"type": "string", "description": "ID from HUMAN_APPROVAL_SCHEMA if doctor has reviewed"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "release_state": {"const": "approved_for_use"}
        },
        "required": ["release_state"]
      },
      "then": {
        "properties": {
          "outpatient_apply_review": {
            "properties": {
              "strict_source_gate_passed": {"const": true},
              "evidence_currency_checked": {"const": true},
              "red_flag_screen_done": {"const": true},
              "safety_review_done": {"const": true},
              "organ_function_checked": {"const": true},
              "special_population_checked": {"const": true},
              "local_feasibility_checked": {"const": true},
              "local_applicability_status": {"enum": ["confirmed", "not_applicable"]},
              "shared_decision_ready": {"const": true},
              "safety_netting_present": {"const": true},
              "follow_up_plan_present": {"const": true},
              "doctor_final_approval_required": {"const": true}
            }
          },
          "audit_trail": {
            "required": ["human_approval_id"],
            "properties": {
              "guardrail_result": {"const": "PASS"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_integrity": {
            "properties": {
              "retracted_sources_detected": {"minItems": 1}
            },
            "required": ["retracted_sources_detected"]
          }
        },
        "required": ["source_integrity"]
      },
      "then": {
        "properties": {
          "release_state": {"enum": ["draft_ai", "guardrail_pending", "doctor_review_required", "retired_or_superseded"]}
        }
      }
    },
    {
      "if": {
        "properties": {
          "prompt_injection_review": {
            "properties": {
              "injection_detected": {"const": true}
            },
            "required": ["injection_detected"]
          }
        },
        "required": ["prompt_injection_review"]
      },
      "then": {
        "properties": {
          "release_state": {"enum": ["draft_ai", "guardrail_pending", "doctor_review_required"]}
        }
      }
    },
    {
      "if": {
        "properties": {
          "conflict_review": {
            "properties": {
              "conflicting_evidence_flag": {"const": true}
            },
            "required": ["conflicting_evidence_flag"]
          }
        },
        "required": ["conflict_review"]
      },
      "then": {
        "properties": {
          "release_state": {"enum": ["draft_ai", "guardrail_pending", "doctor_review_required"]}
        }
      }
    }
  ]
}
