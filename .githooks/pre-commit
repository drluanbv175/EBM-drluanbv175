#!/bin/sh
# pre-commit — chan MOI commit khi Claude Code ↔ Codex con lech.
# Them 2026-07-11; fail-closed toan cuc tu 2026-07-29.
#
# Kich hoat 1 lan (chi can chay 1 lan tren moi may, khong phai moi phien):
#   git config core.hooksPath .githooks
#   chmod +x .githooks/pre-commit
#
# Khong bo qua commit "khong lien quan": drift co the do mot phien Claude/Codex khac
# dang ghi dong thoi. Moi commit duoc coi la mot moc hoan thien, nen phai de lai he
# thong o trang thai dong bo.

COMPLETION_SYNC_FAIL_CLOSED=1

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT" || exit 1

# Moi tool kiem tra deu IN tieng Viet. Tren Windows, stdout cua python mac dinh
# la cp1252 nen chi rieng viec in dong disclaimer da nem UnicodeEncodeError ->
# hook ket luan "chua dong bo" va CHAN COMMIT du moi muc deu PASS (03/08/2026).
# Ep UTF-8 cho moi lenh python duoi day; tren macOS/Linux khong doi gi.
export PYTHONUTF8=1
export PYTHONIOENCODING=utf-8

if ! command -v python3 >/dev/null 2>&1; then
  echo "CHAN COMMIT: khong tim thay python3 de kiem dong bo Claude Code ↔ Codex." >&2
  exit 1
fi

# Neu source/mirror con thay doi NGOAI index, mirror tren dia co the PASS nhung
# snapshot sap commit van lech. Buoc nay dong loi staged-vs-working-tree do.
UNSTAGED_SYNC=$(git diff --name-only -- .claude/agents .Codex/agents .codex/agents)
if [ -n "$UNSTAGED_SYNC" ]; then
  echo "CHAN COMMIT: source/mirror agent con thay doi chua stage:" >&2
  echo "$UNSTAGED_SYNC" | sed 's/^/  - /' >&2
  echo "  Hoan tat enforce → sync → check, sau do stage CA source va mirror." >&2
  exit 1
fi

python3 tools/sync_agents_to_codex.py --check
CHECK_EXIT=$?

if [ "$CHECK_EXIT" -ne 0 ]; then
  echo "" >&2
  echo "CHAN COMMIT: ban vua sua .claude/agents/*.md nhung .Codex/agents *.toml chua dong bo." >&2
  echo "  Chay truoc khi commit:" >&2
  echo "    python3 tools/enforce_agent_guardrails.py" >&2
  echo "    python3 tools/sync_agents_to_codex.py" >&2
  echo "    python3 tools/sync_agents_to_codex.py --check" >&2
  echo "  Roi commit lai." >&2
  echo "  Khan cap can bo qua: git commit --no-verify (KHONG khuyen nghi — se de lai lech am tham)." >&2
  exit 1
fi

python3 tools/check_claude_codex_sync_health.py
if [ "$?" -ne 0 ]; then
  echo "CHAN COMMIT: sync co file nhung guardrail/disclaimer/ha tang chua dat." >&2
  exit 1
fi

python3 tools/verify_claude_code_repo_alignment.py
if [ "$?" -ne 0 ]; then
  echo "CHAN COMMIT: hop dong repo Claude Code/Codex chua dong bo." >&2
  exit 1
fi

# Them 2026-07-16 sau audit doi khang: cong G8 (them 2026-07-14) tung lot luoi
# 11+ file doctrine lien tuc 16 ngay ma hook nay khong bat duoc (chi kiem dong
# bo Codex-mirror, khong kiem NOI DUNG dem-cong-cung). verify_hard_gate_count_
# consistency.py doi chieu moi dong ".claude/agents/*.md" voi gate_contract.py
# (nguon su that) — chan dung LOP LOI nay tai dien, khong chi 1 truong hop G8.
if [ -f tools/verify_hard_gate_count_consistency.py ]; then
  python3 tools/verify_hard_gate_count_consistency.py --check
  GATE_COUNT_EXIT=$?
  if [ "$GATE_COUNT_EXIT" -ne 0 ]; then
    echo "" >&2
    echo "CHAN COMMIT: co dong .claude/agents/*.md liet ke 'cong cung' nhung thieu it nhat 1 gate" >&2
    echo "(doi chieu tools/gate_contract.py::_GATE_REQUIRED_STAKEHOLDERS — nguon su that duy nhat)." >&2
    echo "  Xem chi tiet: python3 tools/verify_hard_gate_count_consistency.py" >&2
    echo "  Khan cap can bo qua: git commit --no-verify (KHONG khuyen nghi)." >&2
    exit 1
  fi
fi

# Plugin khong duoc tu tranh quyen voi nhac truong. Registry + doctrine + flow +
# mirror phai cung khop; worker ngoai allowlist va capability la phai fail-closed.
if [ -f tools/verify_plugin_orchestration.py ]; then
  python3 tools/verify_plugin_orchestration.py
  PLUGIN_ROUTING_EXIT=$?
  if [ "$PLUGIN_ROUTING_EXIT" -ne 0 ]; then
    echo "CHAN COMMIT: quyen so huu plugin/agent/runtime dang drift hoac co duong vong cong." >&2
    echo "  Chay: python3 tools/verify_plugin_orchestration.py" >&2
    exit 1
  fi
fi

# Cổng triển khai giám sát chứng cứ chỉ kiểm CONTRACT ở pre-commit. UAT/online/live
# run là bằng chứng ngoài commit và không được agent giả lập để làm xanh hook.
SURVEILLANCE_GATE="medical-ebm-automation/tools/verify_evidence_surveillance_deployment.py"
if [ -f "$SURVEILLANCE_GATE" ]; then
  python3 "$SURVEILLANCE_GATE" --contract-check --no-write
  SURVEILLANCE_EXIT=$?
  if [ "$SURVEILLANCE_EXIT" -ne 0 ]; then
    echo "CHAN COMMIT: cổng triển khai giám sát chứng cứ bị thiếu/drift hoặc không fail-closed." >&2
    echo "  Chay: python3 $SURVEILLANCE_GATE --contract-check --no-write" >&2
    exit 1
  fi
fi

exit 0
